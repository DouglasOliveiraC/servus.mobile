<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--
    Design system do Servus. Paleta "Azul Naval" — trocada a partir do verde institucional
    original por ser mais reconhecível como identidade institucional/hierárquica (farda,
    plantão, corporação) sem perder sobriedade. Este arquivo centraliza os tokens usados
    pelas 16 telas de feature.
    -->

    <!-- ===== Brand (azul naval) ===== -->
    <Color x:Key="BrandPrimary">#1F3A5F</Color>
    <Color x:Key="BrandPrimaryDark">#152943</Color>
    <Color x:Key="BrandSurface">#E7ECF2</Color>
    <Color x:Key="BrandSurfaceStrong">#C3D0DD</Color>
    <Color x:Key="BrandBorder">#D9E1EA</Color>
    <Color x:Key="BrandSurfaceSubtle">#F5F7FA</Color>
    <Color x:Key="BrandOnPrimarySubtle">#C7D4E1</Color>
    <Color x:Key="BrandOnPrimaryMuted">#5A7A9C</Color>

    <!-- ===== Neutros (escala azulada usada para texto/superfícies) ===== -->
    <Color x:Key="Neutral900">#22282C</Color>
    <Color x:Key="Neutral700">#5A6B67</Color>
    <Color x:Key="Neutral600">#6B7680</Color>
    <Color x:Key="Neutral500">#8A9199</Color>
    <Color x:Key="Neutral400">#8A9490</Color>
    <Color x:Key="Neutral200">#E3E6E5</Color>
    <Color x:Key="Neutral200Alt">#E6E9E8</Color>
    <Color x:Key="Neutral100">#F4F5F6</Color>
    <Color x:Key="Neutral100Alt">#F0F2F1</Color>
    <Color x:Key="Neutral50">#FBFBFB</Color>
    <Color x:Key="Neutral50Alt">#FCFDFC</Color>
    <Color x:Key="Neutral50Alt2">#FAFBFA</Color>

    <!-- ===== Estado: perigo / destrutivo ===== -->
    <Color x:Key="Danger">#B5453F</Color>
    <Color x:Key="DangerStrong">#8A3630</Color>
    <Color x:Key="DangerSurface">#FBEAE9</Color>
    <Color x:Key="DangerBorder">#F0CFCD</Color>

    <!-- ===== Estado: alerta / pendente ===== -->
    <Color x:Key="Warning">#8A6A1F</Color>
    <Color x:Key="WarningSurface">#F3D9A6</Color>

    <!-- ===== Estado: sucesso / positivo (independente do BrandPrimary) ===== -->
    <Color x:Key="Success">#3D6E68</Color>
    <Color x:Key="SuccessStrong">#2C534F</Color>

    <!-- ===== Categórico (indicadores de carga/heatmap) ===== -->
    <Color x:Key="AccentOrange">#D98C3B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>
