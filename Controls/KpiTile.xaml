<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Servus.Mobile.Controls.KpiTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Servus.Mobile.Controls"
    x:DataType="controls:KpiTile"
    x:Name="Root">

    <Border
        StrokeShape="RoundRectangle 12"
        Stroke="{StaticResource Neutral200}"
        BackgroundColor="White"
        Padding="12,12,12,11">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="6">
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding Label, Source={x:Reference Root}}"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="{StaticResource Neutral900}"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                VerticalOptions="Center" />
            <Border
                Grid.Row="0"
                Grid.Column="1"
                StrokeShape="RoundRectangle 6"
                Stroke="Transparent"
                BackgroundColor="{Binding AccentSurface, Source={x:Reference Root}}"
                WidthRequest="26"
                HeightRequest="26"
                Padding="0"
                VerticalOptions="Start">
                <Path
                    Data="{Binding Icon, Source={x:Reference Root}}"
                    Stroke="{Binding Accent, Source={x:Reference Root}}"
                    StrokeThickness="2.2"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Aspect="None"
                    WidthRequest="24"
                    HeightRequest="24"
                    Scale="0.58"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Label
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Text="{Binding Value, Source={x:Reference Root}}"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="{StaticResource Neutral900}"
                LineBreakMode="TailTruncation" />
            <Label
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Text="{Binding Hint, Source={x:Reference Root}}"
                IsVisible="{Binding Hint, Source={x:Reference Root}, Converter={StaticResource StringNotEmptyConverter}}"
                FontSize="11"
                TextColor="{StaticResource Neutral600}"
                LineBreakMode="TailTruncation" />
        </Grid>
    </Border>
</ContentView>
