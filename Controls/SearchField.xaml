<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Servus.Mobile.Controls.SearchField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Servus.Mobile.Controls"
    xmlns:home="clr-namespace:Servus.Mobile.Features.Home"
    x:DataType="controls:SearchField"
    x:Name="Root">

    <!-- Compact pill instead of the outlined SfTextInputLayout: that one is sized for form
         fields with a floating label, and around a one-line search it read as an empty box. -->
    <Border
        x:Name="Pill"
        StrokeShape="RoundRectangle 12"
        Stroke="{StaticResource Neutral200}"
        StrokeThickness="1"
        BackgroundColor="White"
        HeightRequest="44"
        Padding="12,0,4,0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Path
                Data="{x:Static home:HomeIcons.Search}"
                Stroke="{StaticResource Neutral500}"
                StrokeThickness="2"
                StrokeLineCap="Round"
                StrokeLineJoin="Round"
                Aspect="None"
                WidthRequest="24"
                HeightRequest="24"
                Scale="0.7"
                VerticalOptions="Center" />
            <controls:BorderlessEntry
                x:Name="Input"
                Grid.Column="1"
                Text="{Binding Text, Source={x:Reference Root}}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                PlaceholderColor="{StaticResource Neutral500}"
                TextColor="{StaticResource Neutral900}"
                FontSize="14"
                ReturnType="Search"
                ClearButtonVisibility="WhileEditing"
                VerticalOptions="Center"
                Focused="OnInputFocused"
                Unfocused="OnInputUnfocused" />
        </Grid>
    </Border>
</ContentView>
