<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Servus.Mobile.Controls.MemberSearchPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:members="clr-namespace:Servus.Mobile.Services.Members"
    xmlns:controls="clr-namespace:Servus.Mobile.Controls"
    x:DataType="controls:MemberSearchPicker"
    x:Name="Root">

    <VerticalStackLayout Spacing="8">
        <controls:SearchField Placeholder="{Binding Hint, Source={x:Reference Root}}" Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleResults, Source={x:Reference Root}}" Spacing="4">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="members:MemberDto">
                    <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Neutral100}" Padding="12,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Root}, x:DataType=controls:MemberSearchPicker}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Name}" FontSize="13.5" TextColor="{StaticResource Neutral900}" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label
            Text="{Binding OverflowText, Source={x:Reference Root}}"
            IsVisible="{Binding HasOverflow, Source={x:Reference Root}}"
            FontSize="11.5"
            TextColor="{StaticResource Neutral500}"
            HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentView>
