<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Servus.Mobile.Controls.MemberSearchPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:members="clr-namespace:Servus.Mobile.Services.Members"
    xmlns:controls="clr-namespace:Servus.Mobile.Controls"
    x:Name="Root">

    <VerticalStackLayout Spacing="10">
        <sf:SfTextInputLayout Hint="{Binding Hint, Source={x:Reference Root}}" ContainerType="Outlined">
            <Entry Text="{Binding SearchText, Source={x:Reference Root}}" />
        </sf:SfTextInputLayout>

        <CollectionView ItemsSource="{Binding Results, Source={x:Reference Root}}" HeightRequest="140">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="members:MemberDto">
                    <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Neutral100}" Padding="10,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Name}" FontSize="13.5" TextColor="{StaticResource Neutral900}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentView>
