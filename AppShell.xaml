<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Servus.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Servus.Mobile"
    xmlns:login="clr-namespace:Servus.Mobile.Features.Login"
    xmlns:home="clr-namespace:Servus.Mobile.Features.Home"
    Title="Servus.Mobile">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate login:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate home:DashboardPage}"
        Route="MainPage" />

</Shell>
