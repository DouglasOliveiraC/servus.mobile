<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Register.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Register"
    x:DataType="local:RegisterViewModel"
    BackgroundColor="{StaticResource White}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,52,28,28" Spacing="0">

            <!-- Back -->
            <Label
                Text="← Voltar"
                TextColor="{StaticResource Neutral600}"
                FontSize="13"
                Margin="0,0,0,24">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Brand -->
            <VerticalStackLayout Spacing="2" Margin="0,0,0,32">
                <Label Text="Criar conta" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                <Label Text="Preencha seus dados para começar" FontSize="13" TextColor="{StaticResource Neutral600}" />
            </VerticalStackLayout>

            <!-- Form -->
            <VerticalStackLayout Spacing="14">

                <sf:SfTextInputLayout Hint="Nome completo" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}">
                    <Entry
                        Text="{Binding Name}"
                        ReturnType="Next" />
                </sf:SfTextInputLayout>
                <Label
                    Text="{Binding NameError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding NameError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <sf:SfTextInputLayout Hint="E-mail" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}">
                    <Entry
                        Text="{Binding Email}"
                        Keyboard="Email"
                        ReturnType="Next" />
                </sf:SfTextInputLayout>
                <Label
                    Text="{Binding EmailError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding EmailError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <sf:SfTextInputLayout Hint="Senha" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}" EnablePasswordVisibilityToggle="True">
                    <Entry
                        Text="{Binding Password}"
                        IsPassword="True"
                        ReturnType="Next" />
                </sf:SfTextInputLayout>

                <!-- Indicador de força de senha: cada barra acende quando o score atinge seu threshold -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" IsVisible="{Binding Password, Converter={StaticResource StringNotEmptyConverter}}" Margin="4,-6,4,0">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" Color="{Binding PasswordStrengthColor}" IsVisible="{Binding PasswordStrength, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=1}" />
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" Color="{Binding PasswordStrengthColor}" IsVisible="{Binding PasswordStrength, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=2}" />
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" Color="{Binding PasswordStrengthColor}" IsVisible="{Binding PasswordStrength, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=3}" />
                    <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" Color="{Binding PasswordStrengthColor}" IsVisible="{Binding PasswordStrength, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=4}" />
                    <BoxView Grid.Column="4" HeightRequest="4" CornerRadius="2" Color="{Binding PasswordStrengthColor}" IsVisible="{Binding PasswordStrength, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=5}" />
                </Grid>
                <Label
                    Text="{Binding PasswordStrengthLabel}"
                    TextColor="{Binding PasswordStrengthColor}"
                    FontSize="11.5"
                    FontAttributes="Bold"
                    IsVisible="{Binding PasswordStrengthLabel, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,2,0,0" />
                <Label
                    Text="{Binding PasswordError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding PasswordError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <sf:SfTextInputLayout Hint="Confirmar senha" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}" EnablePasswordVisibilityToggle="True">
                    <Entry
                        Text="{Binding ConfirmPassword}"
                        IsPassword="True"
                        ReturnType="Done" />
                </sf:SfTextInputLayout>
                <Label
                    Text="{Binding ConfirmPasswordError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding ConfirmPasswordError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <Label
                    Text="{Binding ServerError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="12.5"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding ServerError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="0,4,0,0" />

                <buttons:SfButton
                    Text="Criar conta"
                    Background="{StaticResource BrandPrimary}"
                    TextColor="White"
                    CornerRadius="9"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Command="{Binding RegisterCommand}"
                    Margin="0,10,0,0" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource BrandPrimary}"
                    Margin="0,8,0,0" />

                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Já tem conta? " TextColor="{StaticResource Neutral600}" />
                            <Span Text="Entrar" TextColor="{StaticResource BrandPrimary}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
