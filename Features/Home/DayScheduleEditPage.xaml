<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Home.DayScheduleEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Home"
    xmlns:rosters="clr-namespace:Servus.Mobile.Services.Rosters"
    xmlns:controls="clr-namespace:Servus.Mobile.Controls"
    x:DataType="local:DayScheduleEditViewModel"
    Title="Editar plantão do dia"
    BackgroundColor="{StaticResource Neutral100}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <Style x:Key="RowAction" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Stroke" Value="{StaticResource Neutral200}" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,4,20,28" Spacing="14">

                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding RosterName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                    <Label Text="{Binding DateLabel}" FontSize="12.5" TextColor="{StaticResource Neutral600}" />
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource DangerSurface}"
                    Padding="14">
                    <Label Text="Não foi possível carregar este plantão agora. Puxe para atualizar." TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Border
                    IsVisible="{Binding SwapWarningMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource WarningSurface}"
                    Padding="12">
                    <Label Text="{Binding SwapWarningMessage}" FontSize="12.5" TextColor="{StaticResource Warning}" />
                </Border>

                <Border
                    IsVisible="{Binding Assignments.Count, Converter={StaticResource IntIsZeroConverter}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="18">
                    <Label Text="Nenhum plantão neste dia." FontSize="13" TextColor="{StaticResource Neutral600}" />
                </Border>

                <!-- BindableLayout, not nested CollectionViews: the page already scrolls, and a
                     CollectionView inside a ScrollView (let alone inside another one) measures and
                     scrolls unreliably on Android. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShiftGroups}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ShiftGroup">
                            <VerticalStackLayout Spacing="6">
                                <Label FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Neutral600}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Shift.StartTime, StringFormat='{0:HH:mm}'}" />
                                            <Span Text=" – " />
                                            <Span Text="{Binding Shift.EndTime, StringFormat='{0:HH:mm}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assignments}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:AssignmentRow">
                                            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" StrokeThickness="1.5" BackgroundColor="White" Padding="14,10">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSwapping}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsMoving}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <Label Grid.Column="0" Text="{Binding MemberName}" FontSize="14" TextColor="{StaticResource Neutral900}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                        <Border
                                                            Grid.Column="1"
                                                            Style="{StaticResource RowAction}"
                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=HasMultipleShifts, x:DataType=local:DayScheduleEditViewModel}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=StartMoveShiftCommand, x:DataType=local:DayScheduleEditViewModel}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Mover" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Neutral700}" />
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource RowAction}" BackgroundColor="{StaticResource BrandSurface}" Stroke="Transparent">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=StartSwapCommand, x:DataType=local:DayScheduleEditViewModel}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Trocar" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Inline swap: opens under the tapped person, so it's always on screen. -->
                                                    <VerticalStackLayout IsVisible="{Binding IsSwapping}" Spacing="8">
                                                        <BoxView Color="{StaticResource Neutral100}" HeightRequest="1" />
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="{Binding MemberName, StringFormat='Colocar no lugar de {0}:'}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                            <Label Grid.Column="1" Text="Cancelar" FontSize="12.5" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" Padding="8,4">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=CancelFormCommand, x:DataType=local:DayScheduleEditViewModel}" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                        </Grid>
                                                        <controls:MemberSearchPicker
                                                            Hint="Buscar na fila desta escala"
                                                            SearchText="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=MemberSearchText, Mode=TwoWay, x:DataType=local:DayScheduleEditViewModel}"
                                                            Results="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=MemberSearchResults, x:DataType=local:DayScheduleEditViewModel}"
                                                            SelectCommand="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=ConfirmSwapCommand, x:DataType=local:DayScheduleEditViewModel}" />
                                                    </VerticalStackLayout>

                                                    <!-- Inline move to another shift of the same day. -->
                                                    <VerticalStackLayout IsVisible="{Binding IsMoving}" Spacing="8">
                                                        <BoxView Color="{StaticResource Neutral100}" HeightRequest="1" />
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="Mover para o turno:" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" VerticalOptions="Center" />
                                                            <Label Grid.Column="1" Text="Cancelar" FontSize="12.5" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" Padding="8,4">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=CancelFormCommand, x:DataType=local:DayScheduleEditViewModel}" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                        </Grid>
                                                        <VerticalStackLayout
                                                            BindableLayout.ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=AvailableShiftsForMove, x:DataType=local:DayScheduleEditViewModel}"
                                                            Spacing="4">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="rosters:ServiceShiftDto">
                                                                    <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Neutral100}" Padding="12,10">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:DayScheduleEditViewModel}}, Path=ConfirmMoveShiftCommand, x:DataType=local:DayScheduleEditViewModel}"
                                                                                CommandParameter="{Binding .}" />
                                                                        </Border.GestureRecognizers>
                                                                        <Label FontSize="13.5" TextColor="{StaticResource Neutral900}">
                                                                            <Label.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{Binding StartTime, StringFormat='{0:HH:mm}'}" />
                                                                                    <Span Text=" – " />
                                                                                    <Span Text="{Binding EndTime, StringFormat='{0:HH:mm}'}" />
                                                                                </FormattedString>
                                                                            </Label.FormattedText>
                                                                        </Label>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" Color="{StaticResource BrandPrimary}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
