<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Home.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Home"
    x:DataType="local:DashboardViewModel"
    BackgroundColor="{StaticResource Neutral100}"
    Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding LoadCommand}">
        <ScrollView>
            <Grid RowDefinitions="Auto,*" RowSpacing="0">

                <!-- Hero claro: identidade + próximo plantão, azul só em acentos -->
                <Border
                    Grid.Row="0"
                    StrokeShape="RoundRectangle 20,20,20,20"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Neutral50}"
                    Padding="24,52,24,22">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">

                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 18"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="ProfilePage" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding UserInitial}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Greeting}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" LineBreakMode="TailTruncation" />
                                    <ActivityIndicator
                                        Grid.Column="1"
                                        IsRunning="{Binding IsBusy}"
                                        IsVisible="{Binding IsBusy}"
                                        Color="{StaticResource BrandPrimary}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding UserEmail}" FontSize="11.5" TextColor="{StaticResource Neutral600}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="2"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource Neutral200}"
                                BackgroundColor="Transparent"
                                Padding="12,7"
                                VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Sair" TextColor="{StaticResource Neutral600}" FontSize="12.5" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <!-- Next duty: card branco com date-chip navy -->
                        <Border
                            Grid.Row="1"
                            IsVisible="{Binding NextDuty, Converter={StaticResource IsNotNullConverter}}"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource BrandBorder}"
                            BackgroundColor="White"
                            Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border
                                    Grid.Column="0"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource BrandPrimary}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="0">
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding NextDuty.Date, StringFormat='{0:dd}'}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="{Binding NextDuty.Date, StringFormat='{0:MMM}'}"
                                            FontSize="10"
                                            TextColor="{StaticResource BrandSurfaceStrong}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Meu próximo plantão" FontSize="9.5" FontAttributes="Bold" TextColor="{StaticResource Neutral500}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Carregando…" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding NextDuty.RosterName}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding NextDuty.OrganizationName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="11.5" TextColor="{StaticResource Neutral600}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="em " />
                                                <Span Text="{Binding NextDuty.DaysUntil}" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" />
                                                <Span Text=" dia(s)" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Stats: chips brancos, número em navy -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Neutral200}" BackgroundColor="White" Padding="10,10">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding OrganizationCount}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" />
                                    <Label Text="Organizações" FontSize="10" TextColor="{StaticResource Neutral600}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Neutral200}" BackgroundColor="White" Padding="10,10">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding RosterCount}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" />
                                    <Label Text="Escalas" FontSize="10" TextColor="{StaticResource Neutral600}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Neutral200}" BackgroundColor="White" Padding="10,10">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding MyUpcomingDutyCount}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" />
                                    <Label Text="Meus plantões (14d)" FontSize="10" TextColor="{StaticResource Neutral600}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

                <!-- Corpo: cards brancos com traço sutil sob o hero -->
                <VerticalStackLayout Grid.Row="1" Padding="20,18,20,28" Spacing="18">

                <!-- Error state -->
                <Border
                    IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource DangerBorder}"
                    BackgroundColor="{StaticResource DangerSurface}"
                    Padding="14">
                    <Label
                        Text="Não foi possível carregar seus dados agora. Puxe para atualizar."
                        TextColor="{StaticResource Danger}"
                        FontSize="13" />
                </Border>

                <!-- Empty state -->
                <Border
                    IsVisible="{Binding OrganizationCount, Converter={StaticResource IntIsZeroConverter}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource BrandBorder}"
                    BackgroundColor="White"
                    Padding="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Você ainda não participa de nenhuma organização." FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                        <Label Text="Peça um código de convite ao administrador da sua unidade." FontSize="12.5" TextColor="{StaticResource Neutral600}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Swap trend card -->
                <Border
                    IsVisible="{Binding OrganizationCount, Converter={StaticResource IntIsNotZeroConverter}}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BrandBorder}"
                    BackgroundColor="White"
                    Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Trocas de plantão" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                            <Label Grid.Column="1" FontSize="12.5" TextColor="{StaticResource Neutral600}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SwapCountLastPeriod}" TextColor="{StaticResource BrandPrimary}" FontAttributes="Bold" />
                                        <Span Text=" nas últimas 6 semanas" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                        <chart:SfCartesianChart HeightRequest="120" IsVisible="{Binding SwapTrend.Count, Converter={StaticResource IntIsNotZeroConverter}}">
                            <chart:SfCartesianChart.XAxes>
                                <chart:CategoryAxis ShowMajorGridLines="False">
                                    <chart:CategoryAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{StaticResource Neutral600}" FontSize="10" />
                                    </chart:CategoryAxis.LabelStyle>
                                </chart:CategoryAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis IsVisible="False" ShowMajorGridLines="False" />
                            </chart:SfCartesianChart.YAxes>
                            <chart:SfCartesianChart.Series>
                                <chart:ColumnSeries
                                    ItemsSource="{Binding SwapTrend}"
                                    XBindingPath="PeriodLabel"
                                    YBindingPath="Count"
                                    Fill="{StaticResource BrandPrimary}"
                                    CornerRadius="4,4,0,0"
                                    ShowDataLabels="True">
                                    <chart:ColumnSeries.DataLabelSettings>
                                        <chart:CartesianDataLabelSettings>
                                            <chart:CartesianDataLabelSettings.LabelStyle>
                                                <chart:ChartDataLabelStyle TextColor="{StaticResource Neutral900}" FontSize="10.5" FontAttributes="Bold" />
                                            </chart:CartesianDataLabelSettings.LabelStyle>
                                        </chart:CartesianDataLabelSettings>
                                    </chart:ColumnSeries.DataLabelSettings>
                                </chart:ColumnSeries>
                            </chart:SfCartesianChart.Series>
                        </chart:SfCartesianChart>
                    </VerticalStackLayout>
                </Border>

                <!-- Member load distribution -->
                <Border
                    IsVisible="{Binding MemberLoad.Count, Converter={StaticResource IntIsNotZeroConverter}}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BrandBorder}"
                    BackgroundColor="White"
                    Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Distribuição de plantões por pessoa" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                        <chart:SfCircularChart HeightRequest="220">
                            <chart:SfCircularChart.Legend>
                                <chart:ChartLegend Placement="Right">
                                    <chart:ChartLegend.LabelStyle>
                                        <chart:ChartLegendLabelStyle TextColor="{StaticResource Neutral600}" FontSize="11" />
                                    </chart:ChartLegend.LabelStyle>
                                </chart:ChartLegend>
                            </chart:SfCircularChart.Legend>
                            <chart:SfCircularChart.Series>
                                <chart:DoughnutSeries
                                    ItemsSource="{Binding MemberLoad}"
                                    XBindingPath="MemberName"
                                    YBindingPath="AssignmentCount"
                                    PaletteBrushes="{x:Static local:DashboardPalette.Brushes}"
                                    EnableTooltip="True"
                                    InnerRadius="0.6" />
                            </chart:SfCircularChart.Series>
                        </chart:SfCircularChart>
                    </VerticalStackLayout>
                </Border>

                <!-- Coverage heatmap -->
                <Border
                    IsVisible="{Binding CoverageDays.Count, Converter={StaticResource IntIsNotZeroConverter}}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{StaticResource BrandBorder}"
                    BackgroundColor="White"
                    Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Cobertura dos próximos 14 dias" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding CoverageDays}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:CoverageDayPoint">
                                    <Border
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        BackgroundColor="{Binding StatusColor}"
                                        HeightRequest="42"
                                        Padding="0">
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label
                                                Text="{Binding WeekdayLabel}"
                                                FontSize="8.5"
                                                TextColor="White"
                                                Opacity="0.85"
                                                HorizontalTextAlignment="Center" />
                                            <Label
                                                Text="{Binding DayLabel}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <BoxView Grid.Column="0" Color="{StaticResource Success}" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Coberto" FontSize="10.5" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" />
                            <BoxView Grid.Column="2" Color="{StaticResource AccentOrange}" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center" Margin="10,0,0,0" />
                            <Label Grid.Column="3" Text="Falta gente" FontSize="10.5" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" />
                            <BoxView Grid.Column="4" Color="{StaticResource Neutral200}" WidthRequest="10" HeightRequest="10" CornerRadius="2" VerticalOptions="Center" Margin="10,0,0,0" />
                            <Label Grid.Column="5" Text="Sem escala no dia" FontSize="10.5" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick actions -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Acesso rápido" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Trocas de plantão" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="SwapRequestsPage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Indisponibilidade" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="UnavailabilityPage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Perfil" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="ProfilePage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Entrar em organização" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="JoinOrganizationPage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Gerenciar organizações" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="OrganizationListPage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                            <Label Text="Membros" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" HorizontalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToQuickActionCommand}" CommandParameter="MembersPage" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Organizations -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding Organizations.Count, Converter={StaticResource IntIsNotZeroConverter}}">
                    <Label Text="Minhas organizações" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />

                    <CollectionView ItemsSource="{Binding Organizations}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:OrganizationSummary">
                                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="14.5" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                                            <Label FontSize="12" TextColor="{StaticResource Neutral600}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding RosterCount}" />
                                                        <Span Text=" escala(s) · " />
                                                        <Span Text="{Binding UpcomingAssignmentCount}" />
                                                        <Span Text=" plantão(ões) em 14 dias" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Text="›"
                                            FontSize="20"
                                            TextColor="{StaticResource Neutral600}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Upcoming duties, grouped by day -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding DailyDuties.Count, Converter={StaticResource IntIsNotZeroConverter}}">
                    <Label Text="Próximos plantões" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />

                    <CollectionView ItemsSource="{Binding VisibleDailyDuties}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:DailyDutySummary">
                                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrandBorder}" BackgroundColor="White" Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:DashboardViewModel}}, Path=OpenDayDetailCommand}"
                                            CommandParameter="{Binding Date}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                        <Border
                                            Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource BrandSurface}"
                                            HeightRequest="56"
                                            WidthRequest="56">
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                <Label
                                                    Text="{Binding Date, StringFormat='{0:dd}'}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource BrandPrimary}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="{Binding Date, StringFormat='{0:MMM}'}"
                                                    FontSize="10.5"
                                                    TextColor="{StaticResource BrandPrimary}"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TotalAssignments}" />
                                                        <Span Text=" plantão(ões) em " />
                                                        <Span Text="{Binding RosterCount}" />
                                                        <Span Text=" escala(s)" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label
                                                Text="{Binding PreviewNames, Converter={StaticResource StringJoinConverter}}"
                                                FontSize="12.5"
                                                TextColor="{StaticResource Neutral600}"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="2"
                                            IsVisible="{Binding HasMine}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource BrandPrimary}"
                                            Padding="8,4"
                                            VerticalOptions="Center">
                                            <Label Text="Eu" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <buttons:SfButton
                        Text="Carregar mais"
                        IsVisible="{Binding HasMoreDailyDuties}"
                        Background="{StaticResource Neutral100}"
                        TextColor="{StaticResource Neutral900}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="12.5"
                        Command="{Binding ShowMoreDailyDutiesCommand}" />
                </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </RefreshView>

</ContentPage>
