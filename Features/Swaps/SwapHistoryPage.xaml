<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Swaps.SwapHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Swaps"
    x:DataType="local:SwapHistoryViewModel"
    Title="Histórico de trocas"
    BackgroundColor="{StaticResource Neutral100}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <local:SwapCauseLabelConverter x:Key="SwapCauseLabelConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="14">

                <Border
                    IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource DangerSurface}"
                    Padding="14">
                    <Label Text="Não foi possível carregar o histórico agora. Puxe para atualizar." TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Border
                    IsVisible="{Binding Entries.Count, Converter={StaticResource IntIsZeroConverter}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="18">
                    <Label Text="Nenhuma troca registrada para esta escala ainda." FontSize="14" TextColor="{StaticResource Neutral600}" />
                </Border>

                <CollectionView ItemsSource="{Binding Entries}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:SwapHistoryEntryViewData">
                            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="White" Padding="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="{StaticResource Neutral600}" />
                                        <Label FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FromMemberName}" />
                                                    <Span Text=" → " TextColor="{StaticResource Neutral600}" FontAttributes="None" />
                                                    <Span Text="{Binding ToMemberName}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="Transparent"
                                        BackgroundColor="{StaticResource BrandSurface}"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                        <Label Text="{Binding Cause, Converter={StaticResource SwapCauseLabelConverter}}" TextColor="{StaticResource BrandPrimary}" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
