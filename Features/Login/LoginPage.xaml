<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Login"
    x:DataType="local:LoginViewModel"
    BackgroundColor="{StaticResource White}"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    ControlTemplate="{x:Null}">

    <ScrollView>
        <VerticalStackLayout Padding="28,0" Spacing="0" VerticalOptions="Center">

            <!-- Brand lockup horizontal: monograma + wordmark na mesma linha -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,44">
                <Border
                    Grid.Column="0"
                    WidthRequest="52"
                    HeightRequest="52"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    VerticalOptions="Center">
                    <Label
                        Text="S"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Servus" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                    <Label Text="Gestão de escalas e plantões" FontSize="12.5" TextColor="{StaticResource Neutral600}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Form -->
            <VerticalStackLayout Spacing="14">

                <sf:SfTextInputLayout Hint="E-mail" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}">
                    <Entry
                        Text="{Binding Email}"
                        Keyboard="Email"
                        ReturnType="Next" />
                </sf:SfTextInputLayout>
                <Label
                    Text="{Binding EmailError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding EmailError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <sf:SfTextInputLayout Hint="Senha" ContainerType="Outlined" ContainerBackground="{StaticResource Neutral50}" EnablePasswordVisibilityToggle="True">
                    <Entry
                        Text="{Binding Password}"
                        IsPassword="True"
                        ReturnType="Done" />
                </sf:SfTextInputLayout>
                <Label
                    Text="{Binding PasswordError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="11.5"
                    IsVisible="{Binding PasswordError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="4,-8,0,0" />

                <Label
                    Text="Esqueci minha senha"
                    TextColor="{StaticResource BrandPrimary}"
                    FontSize="12.5"
                    FontAttributes="Bold"
                    HorizontalOptions="End"
                    Margin="0,0,4,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    Text="{Binding ServerError}"
                    TextColor="{StaticResource Danger}"
                    FontSize="12.5"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding ServerError, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="0,4,0,0" />

                <buttons:SfButton
                    Text="Entrar"
                    Background="{StaticResource BrandPrimary}"
                    TextColor="White"
                    CornerRadius="9"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Command="{Binding LoginCommand}"
                    Margin="0,10,0,0" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource BrandPrimary}"
                    Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,16,0,0" VerticalOptions="Center">
                    <BoxView Grid.Column="0" HeightRequest="1" Color="{StaticResource Neutral200}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="ou" TextColor="{StaticResource Neutral500}" FontSize="12" Margin="10,0" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Neutral200}" VerticalOptions="Center" />
                </Grid>

                <buttons:SfButton
                    Text="Entrar com Google"
                    ImageSource="google_icon.svg"
                    Background="{StaticResource Neutral100}"
                    TextColor="{StaticResource Neutral900}"
                    StrokeThickness="0"
                    CornerRadius="9"
                    HeightRequest="48"
                    FontAttributes="None"
                    Command="{Binding ContinueWithGoogleCommand}"
                    Margin="0,14,0,0" />

                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Ainda não tem conta? " TextColor="{StaticResource Neutral600}" />
                            <Span Text="Criar conta" TextColor="{StaticResource BrandPrimary}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
