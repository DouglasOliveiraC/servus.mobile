<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.Unavailability.UnavailabilityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:Servus.Mobile.Features.Unavailability"
    xmlns:unavail="clr-namespace:Servus.Mobile.Services.Unavailabilities"
    x:DataType="local:UnavailabilityViewModel"
    Title="Minhas indisponibilidades"
    BackgroundColor="{StaticResource Neutral100}"
    Shell.NavBarIsVisible="True">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

                <Border
                    IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource DangerSurface}"
                    Padding="14">
                    <Label Text="Não foi possível carregar seus dados agora. Puxe para atualizar." TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Border
                    IsVisible="{Binding HasNoMember}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="18">
                    <Label Text="Você ainda não está vinculado a um membro. Use um código de convite para entrar em uma organização." FontSize="13" TextColor="{StaticResource Neutral600}" />
                </Border>

                <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Adicionar período" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Início" FontSize="11.5" TextColor="{StaticResource Neutral600}" />
                                <DatePicker Date="{Binding NewStartDate}" Format="dd/MM/yyyy" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Fim" FontSize="11.5" TextColor="{StaticResource Neutral600}" />
                                <DatePicker Date="{Binding NewEndDate}" Format="dd/MM/yyyy" />
                            </VerticalStackLayout>
                        </Grid>
                        <buttons:SfButton
                            Text="Adicionar"
                            Background="{StaticResource BrandPrimary}"
                            TextColor="White"
                            CornerRadius="9"
                            HeightRequest="44"
                            FontAttributes="Bold"
                            Command="{Binding AddCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Períodos registrados" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />

                    <Border
                        IsVisible="{Binding Periods.Count, Converter={StaticResource IntIsZeroConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        BackgroundColor="White"
                        Padding="18">
                        <Label Text="Nenhum período de indisponibilidade registrado." FontSize="13" TextColor="{StaticResource Neutral600}" />
                    </Border>

                    <CollectionView ItemsSource="{Binding Periods}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="unavail:MemberUnavailabilityDto">
                                <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="White" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" FontSize="13.5" TextColor="{StaticResource Neutral900}" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding StartDate, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" />
                                                    <Span Text=" até " TextColor="{StaticResource Neutral600}" />
                                                    <Span Text="{Binding EndDate, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label
                                            Grid.Column="1"
                                            Text="Remover"
                                            TextColor="{StaticResource Danger}"
                                            FontSize="12.5"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:UnavailabilityViewModel}}}" CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
