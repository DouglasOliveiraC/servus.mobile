<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Servus.Mobile.Features.CalendarOverrides.CalendarOverridesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:Servus.Mobile.Features.CalendarOverrides"
    xmlns:overrides="clr-namespace:Servus.Mobile.Services.CalendarOverrides"
    x:DataType="local:CalendarOverridesViewModel"
    Title="Dias especiais"
    BackgroundColor="{StaticResource Neutral100}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:RestDayLabelConverter x:Key="RestDayLabelConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

                <Border
                    IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource DangerSurface}"
                    Padding="14">
                    <Label Text="Não foi possível carregar os dias especiais agora. Puxe para atualizar." TextColor="{StaticResource Danger}" FontSize="13" />
                </Border>

                <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="White" Padding="14">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="De" FontSize="11.5" TextColor="{StaticResource Neutral600}" />
                            <DatePicker Date="{Binding RangeFrom}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Até" FontSize="11.5" TextColor="{StaticResource Neutral600}" />
                            <DatePicker Date="{Binding RangeTo}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Adicionar dia especial" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />
                        <DatePicker Date="{Binding NewDate}" Format="dd/MM/yyyy" />
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding NewIsRestDay}" />
                            <Label Text="É dia de folga/feriado" FontSize="13" TextColor="{StaticResource Neutral900}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <buttons:SfButton
                            Text="Adicionar"
                            Background="{StaticResource BrandPrimary}"
                            TextColor="White"
                            CornerRadius="9"
                            HeightRequest="44"
                            FontAttributes="Bold"
                            Command="{Binding AddCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Dias marcados" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" />

                    <Border
                        IsVisible="{Binding Overrides.Count, Converter={StaticResource IntIsZeroConverter}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        BackgroundColor="White"
                        Padding="18">
                        <Label Text="Nenhum dia especial marcado no período." FontSize="13" TextColor="{StaticResource Neutral600}" />
                    </Border>

                    <CollectionView ItemsSource="{Binding Overrides}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="overrides:CalendarDayOverrideDto">
                                <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="White" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="13.5" FontAttributes="Bold" TextColor="{StaticResource Neutral900}" VerticalOptions="Center" />
                                        <Border
                                            Grid.Column="1"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="Transparent"
                                            BackgroundColor="{StaticResource BrandSurface}"
                                            Padding="8,3"
                                            VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleRestDayCommand, Source={RelativeSource AncestorType={x:Type local:CalendarOverridesViewModel}}}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding IsRestDay, Converter={StaticResource RestDayLabelConverter}}" TextColor="{StaticResource BrandPrimary}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Label
                                            Grid.Column="2"
                                            Text="Remover"
                                            TextColor="{StaticResource Danger}"
                                            FontSize="12.5"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:CalendarOverridesViewModel}}}" CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
