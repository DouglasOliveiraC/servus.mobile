<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Servus.Mobile"
             xmlns:converters="clr-namespace:Servus.Mobile.Converters"
             xmlns:controls="clr-namespace:Servus.Mobile.Controls"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Servus.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:IntIsZeroConverter x:Key="IntIsZeroConverter" />
            <converters:IntIsNotZeroConverter x:Key="IntIsNotZeroConverter" />
            <converters:StringJoinConverter x:Key="StringJoinConverter" />
            <converters:IntAtLeastConverter x:Key="IntAtLeastConverter" />
            <converters:ChevronConverter x:Key="ChevronConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- Every ContentPage gets the floating menu button through this template; pages
                 that must not show it (Login, Register) set ControlTemplate="{x:Null}". -->
            <ControlTemplate x:Key="AppPageTemplate">
                <Grid>
                    <ContentPresenter />
                    <controls:FloatingMenuButton />
                </Grid>
            </ControlTemplate>

            <!-- Single look for every form field. No page sets HelperText/ErrorText, so the space
                 SfTextInputLayout reserves below the outline for them by default was only dead
                 height; the default input padding added more on top of the native Entry's own. -->
            <Style TargetType="sf:SfTextInputLayout">
                <Setter Property="ContainerType" Value="Outlined" />
                <Setter Property="ContainerBackground" Value="{StaticResource Neutral50}" />
                <Setter Property="OutlineCornerRadius" Value="9" />
                <Setter Property="ReserveSpaceForAssistiveLabels" Value="False" />
                <Setter Property="InputViewPadding" Value="12,0,12,0" />
            </Style>

            <!-- Repeats the Page style's setters from Styles.xaml: only the most specific implicit
                 style applies, so this one would otherwise drop them for every ContentPage. -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
                <Setter Property="ControlTemplate" Value="{StaticResource AppPageTemplate}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
