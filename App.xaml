<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Servus.Mobile"
             xmlns:converters="clr-namespace:Servus.Mobile.Converters"
             x:Class="Servus.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:IntIsZeroConverter x:Key="IntIsZeroConverter" />
            <converters:IntIsNotZeroConverter x:Key="IntIsNotZeroConverter" />
            <converters:StringJoinConverter x:Key="StringJoinConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
