<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Servus.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Servus</ApplicationTitle>

		<!-- Android's identity for the app, together with the signing key: installed copies only
		     accept an update carrying both unchanged. Also the package registered in Firebase. -->
		<ApplicationId>br.com.newsight.servus</ApplicationId>

		<!-- Overridden by the release workflow from the git tag and the run number. -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Off by default in MAUI (unlike ASP.NET Core): without it HttpClient does not send
		     traceparent, and client telemetry cannot be correlated with the API's. -->
		<HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0D2239" />

		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D2239" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="OpenTelemetry" Version="1.15.3" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="34.2.5" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="34.2.5" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="34.2.5" />
		<PackageReference Include="Syncfusion.Maui.Calendar" Version="34.2.5" />
		<PackageReference Include="Syncfusion.Maui.Inputs" Version="34.2.5" />
		<PackageReference Include="Syncfusion.Maui.Expander" Version="34.2.5" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />

		<!-- Firebase pulls Fragment 1.9.0, which absorbed the -ktx classes, while MAUI still
		     brings Fragment.Ktx 1.8.x; with both, D8 fails on duplicate types. Pinning the ktx
		     package to the same version leaves only one copy. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />

		<!-- Optional so the app still builds from a fresh clone; without it there is no push,
		     and PushRegistrationService gives up quietly. -->
		<GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json')" />
	</ItemGroup>

	<!--
	  Compiles the secrets read from the BUILD MACHINE's environment into the assembly. Reading
	  them at runtime does not work: the variable does not exist on the phone, so the installed app
	  silently ran without telemetry and without the Syncfusion license. The generated file lives
	  in obj/ and is never committed, so the secrets stay out of the repository.
	-->
	<Target Name="GenerateBuildSecrets" BeforeTargets="BeforeCompile;CoreCompile">
		<PropertyGroup>
			<BuildSecretsFile>$(IntermediateOutputPath)BuildSecrets.g.cs</BuildSecretsFile>
			<AppInsightsConnectionStringValue>$(APPINSIGHTS_CONNECTION_STRING)</AppInsightsConnectionStringValue>
			<SyncfusionLicenseKeyValue>$(SYNCFUSION_LICENSE_KEY)</SyncfusionLicenseKeyValue>
		</PropertyGroup>

		<WriteLinesToFile File="$(BuildSecretsFile)" Lines="// &lt;auto-generated /&gt; Gerado pelo target GenerateBuildSecrets (Servus.Mobile.csproj).;namespace Servus.Mobile%3B;internal static class BuildSecrets;{;    public const string ApplicationInsightsConnectionString = %22$(AppInsightsConnectionStringValue)%22%3B;    public const string SyncfusionLicenseKey = %22$(SyncfusionLicenseKeyValue)%22%3B;}" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Compile Include="$(BuildSecretsFile)" />
			<FileWrites Include="$(BuildSecretsFile)" />
		</ItemGroup>
	</Target>

</Project>
